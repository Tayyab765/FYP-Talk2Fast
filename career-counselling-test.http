### Career Counselling Service API Tests
### Base URL: http://localhost:3003 (direct) or http://localhost:5000 (via gateway)

@baseUrl = http://localhost:5000
@directUrl = http://localhost:3003
@token = your_jwt_token_here
@guestId = guest_test_123456

###############################################
# PUBLIC ENDPOINTS
###############################################

### Health Check (Direct)
GET {{directUrl}}/health

### Health Check (Via Gateway)
GET {{baseUrl}}/api/career/health

### Root Endpoint
GET {{directUrl}}/

### Get All Assessment Questions (No Auth)
GET {{baseUrl}}/api/career/questions

### Get All Assessment Questions (With Auth - Optional)
GET {{baseUrl}}/api/career/questions
Authorization: Bearer eyJhbGciOiJIUzI1NiIsImtpZCI6IlRabGxpVjdtTm13V1AxVHYiLCJ0eXAiOiJKV1QifQ..HlvqLD0HVJqy681vT9xF5aNaxONGYXz076ztTRAk0TU


###############################################
# AUTHENTICATED USER ENDPOINTS
###############################################

