  "message": "Message 3 - Testing performance"
}

###############################################################################
# NOTES
###############################################################################

# Success Criteria:
# ✅ All health checks return 200 OK
# ✅ Signup creates user and returns session
# ✅ Login returns valid token
# ✅ Profile endpoint returns user data
# ✅ Guest session creation returns guestId
# ✅ Messages are saved and AI responses generated
# ✅ History retrieval works for both auth and guest users
# ✅ Conversation deletion works
# ✅ Error handling returns appropriate status codes
# ✅ Service communication works (Gateway → Auth → Chatbot)

# Troubleshooting:
# - If services don't respond, check they're running: npm run dev
# - If auth fails, verify MongoDB is running
# - If AI responses fail, check RAG_API_URL in chatbot service
# - Check logs in logs/combined.log for details
