###############################################################################
# MICROSERVICES API TESTS
# Test all migrated features in the microservices architecture
# All requests go through API Gateway on port 5000
###############################################################################

@gateway = http://localhost:5000
@authService = http://localhost:5001
@chatbotService = http://localhost:5002

# Update these after testing
@token = eyJhbGciOiJIUzI1NiIsImtpZCI6IlRabGxpVjdtTm13V1AxVHYiLCJ0eXAiOiJKV1QifQ..Wc4D5Kd4qSgUvtzHk-yC8Pl1a1kzw3JX_r5OQ-jazBA
@userId = YOUR_USER_ID_HERE
@guestId = guest_6fd9b0c1-28b8-4e28-9719-e05ed4ace1cd
@conversationId = 69af1bfeb2e3bad3963b63a0

###############################################################################
# SERVICE HEALTH CHECKS
###############################################################################

### Gateway Health Check
GET {{gateway}}/health

### Auth Service Health Check (Direct)
GET {{authService}}/health

### Chatbot Service Health Check (Direct)
GET {{chatbotService}}/health

###############################################################################
# AUTHENTICATION TESTS (via Gateway)
###############################################################################

### 1. User Signup
POST {{gateway}}/api/auth/signup
Content-Type: application/json

{
    "email": "testuser@example.com",
    "password": "SecurePass123",
    "full_name": "Test User"
}

###

### 2. User Login
# @name login
POST {{gateway}}/api/auth/login
Content-Type: application/json

{
    "email": "tayyabattiq908@gmail.com",
    "password": "tayyab456"
}

### 3. Get User Profile (Authenticated)
GET {{gateway}}/api/auth/profile
Authorization: Bearer eyJhbGciOiJIUzI1NiIsImtpZCI6IlRabGxpVjdtTm13V1AxVHYiLCJ0eXAiOiJKV1QifQ..Wc4D5Kd4qSgUvtzHk-yC8Pl1a1kzw3JX_r5OQ-jazBA


### 4. Create Guest Session
# @name guestSession
POST {{gateway}}/api/auth/guest-session
Content-Type: application/json

### 5. Refresh Guest Session (with existing guest ID)
POST {{gateway}}/api/auth/guest-session
Content-Type: application/json
x-guest-id: guest_6fd9b0c1-28b8-4e28-9719-e05ed4ace1cd

### 6. Get Guest Profile
GET {{gateway}}/api/auth/profile
x-guest-id: guest_6fd9b0c1-28b8-4e28-9719-e05ed4ace1cd

### 7. Forgot Password
POST {{gateway}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "testuser@example.com"
}

### 8. User Logout
POST {{gateway}}/api/auth/logout
Authorization: Bearer eyJhbGciOiJIUzI1NiIsImtpZCI6IlRabGxpVjdtTm13V1AxVHYiLCJ0eXAiOiJKV1QifQ..Wc4D5Kd4qSgUvtzHk-yC8Pl1a1kzw3JX_r5OQ-jazBA


###############################################################################
# CHATBOT TESTS - AUTHENTICATED USER (via Gateway)
###############################################################################

### 9. Send Message (Authenticated User)
POST {{gateway}}/api/chatbot/message
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsImtpZCI6IlRabGxpVjdtTm13V1AxVHYiLCJ0eXAiOiJKV1QifQ..Wc4D5Kd4qSgUvtzHk-yC8Pl1a1kzw3JX_r5OQ-jazBA

{
  "recipient_id": "ai-assistant",
  "message": "Hello! Can you help me with my studies?"
}

### 10. Send Another Message (Same Conversation)
POST {{gateway}}/api/chatbot/message
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsImtpZCI6IlRabGxpVjdtTm13V1AxVHYiLCJ0eXAiOiJKV1QifQ..Wc4D5Kd4qSgUvtzHk-yC8Pl1a1kzw3JX_r5OQ-jazBA

{
  "recipient_id": "ai-assistant",
  "message": "I need help with mathematics."
}

### 11. Get Conversation History by User ID
GET {{gateway}}/api/chatbot/history/{{userId}}
Authorization: Bearer eyJhbGciOiJIUzI1NiIsImtpZCI6IlRabGxpVjdtTm13V1AxVHYiLCJ0eXAiOiJKV1QifQ..Wc4D5Kd4qSgUvtzHk-yC8Pl1a1kzw3JX_r5OQ-jazBA


### 12. Get Conversation History by Conversation ID
GET {{gateway}}/api/chatbot/history/{{conversationId}}
Authorization: Bearer {{token}}

### 13. Delete Conversation
DELETE {{gateway}}/api/chatbot/history/{{conversationId}}
Authorization: Bearer {{token}}

###############################################################################
# CHATBOT TESTS - GUEST USER (via Gateway)
###############################################################################

### 14. Send Message (Guest User - First Time)
POST {{gateway}}/api/chatbot/message
Content-Type: application/json
x-guest-id: guest_6fd9b0c1-28b8-4e28-9719-e05ed4ace1cd

{
  "recipient_id": "ai-assistant",
  "message": "Hi, I'm a guest. Can you help me?"
}

### 15. Send Another Message (Guest User - Same Session)
POST {{gateway}}/api/chatbot/message
Content-Type: application/json
x-guest-id: guest_6fd9b0c1-28b8-4e28-9719-e05ed4ace1cd

{
  "recipient_id": "ai-assistant",
  "message": "What topics can you help me with?"
}

### 16. Get Guest Conversation History by Guest ID
GET {{gateway}}/api/chatbot/history/{{guestId}}
x-guest-id: guest_6fd9b0c1-28b8-4e28-9719-e05ed4ace1cd

### 17. Get Guest Conversation History by Conversation ID
GET {{gateway}}/api/chatbot/history/{{conversationId}}
x-guest-id: guest_6fd9b0c1-28b8-4e28-9719-e05ed4ace1cd

### 18. Delete Guest Conversation
DELETE {{gateway}}/api/chatbot/history/{{conversationId}}
x-guest-id: {{guestId}}

###############################################################################
# DIRECT SERVICE TESTS (bypassing Gateway)
# These test direct access to services - usually not needed in production
###############################################################################

### 19. Direct Auth Service - Signup
POST {{authService}}/api/auth/signup
Content-Type: application/json

{
  "email": "directtest@example.com",
  "password": "DirectPass123",
  "full_name": "Direct Test User"
}

### 20. Direct Auth Service - Login
POST {{authService}}/api/auth/login
Content-Type: application/json

{
  "email": "directtest@example.com",
  "password": "DirectPass123"
}

### 21. Direct Chatbot Service - Send Message (requires valid token)
POST {{chatbotService}}/api/chatbot/message
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "recipient_id": "ai-assistant",
  "message": "Direct service test message"
}

###############################################################################
# ERROR HANDLING TESTS
###############################################################################

### 22. Invalid Login Credentials
POST {{gateway}}/api/auth/login
Content-Type: application/json

{
  "email": "nonexistent@example.com",
  "password": "wrongpassword"
}

### 23. Send Message Without Authentication
POST {{gateway}}/api/chatbot/message
Content-Type: application/json

{
  "recipient_id": "ai-assistant",
  "message": "This should fail"
}

### 24. Access Profile Without Token
GET {{gateway}}/api/auth/profile

### 25. Invalid Guest ID
POST {{gateway}}/api/chatbot/message
Content-Type: application/json
x-guest-id: invalid_guest_id_format

{
  "recipient_id": "ai-assistant",
  "message": "This should fail"
}

### 26. Get Non-existent Conversation
GET {{gateway}}/api/chatbot/history/000000000000000000000000
Authorization: Bearer {{token}}

### 27. Delete Non-existent Conversation
DELETE {{gateway}}/api/chatbot/history/000000000000000000000000
Authorization: Bearer {{token}}

###############################################################################
# INTEGRATION TESTS
###############################################################################

### 28. Full Flow - Signup → Login → Send Message → Get History → Delete
# Step 1: Signup
POST {{gateway}}/api/auth/signup
Content-Type: application/json

{
  "email": "tayyabattiq543@gmail.com",
  "password": "123456",
  "full_name": "Flow Test User"
}

### Step 2: Login (copy token from response)
POST {{gateway}}/api/auth/login
Content-Type: application/json

{
  "email": "flowtest@example.com",
  "password": "FlowTest123"
}

### Step 3: Send Message (use token from step 2)
POST {{gateway}}/api/chatbot/message
Content-Type: application/json
Authorization: Bearer YOUR_TOKEN_FROM_LOGIN

{
  "recipient_id": "ai-assistant",
  "message": "Integration test message"
}

### Step 4: Get History (use userId and token from login)
GET {{gateway}}/api/chatbot/history/YOUR_USER_ID_FROM_LOGIN
Authorization: Bearer YOUR_TOKEN_FROM_LOGIN

### Step 5: Delete Conversation (use conversationId from step 3 response)
DELETE {{gateway}}/api/chatbot/history/CONVERSATION_ID_FROM_SEND
Authorization: Bearer YOUR_TOKEN_FROM_LOGIN

###############################################################################
# GUEST USER FULL FLOW
###############################################################################

### 29. Guest Flow - Create Session → Send Message → Get History → Delete
# Step 1: Create Guest Session
POST {{gateway}}/api/auth/guest-session

### Step 2: Send Message as Guest (use guestId from step 1)
POST {{gateway}}/api/chatbot/message
Content-Type: application/json
x-guest-id: YOUR_GUEST_ID_FROM_STEP1

{
  "recipient_id": "ai-assistant",
  "message": "Guest integration test"
}

### Step 3: Get Guest History (use guestId from step 1)
GET {{gateway}}/api/chatbot/history/YOUR_GUEST_ID_FROM_STEP1
x-guest-id: YOUR_GUEST_ID_FROM_STEP1

### Step 4: Delete Guest Conversation (use conversationId from step 2)
DELETE {{gateway}}/api/chatbot/history/CONVERSATION_ID_FROM_STEP2
x-guest-id: YOUR_GUEST_ID_FROM_STEP1

