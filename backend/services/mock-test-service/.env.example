PORT=5005

# Mock Test Service MongoDB Connection
# Local MongoDB (Development)
# MOCKTEST_MONGODB_URI=mongodb://localhost:27017/hamza_mocktest

# MongoDB Atlas (Production/Cloud)
# Replace with your Atlas connection string
MOCKTEST_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hamza_mocktest?retryWrites=true&w=majority

# Auth Service URL for token verification
AUTH_SERVICE_URL=http://localhost:5001

# Supabase Configuration (for token verification)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# Logging
LOG_LEVEL=info
