{
  "info": {
    "name": "Career Counseling API",
    "description": "Production-grade career counseling system with AI-powered recommendations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Get Assessment Questions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/career/questions",
          "host": ["{{base_url}}"],
          "path": ["career", "questions"]
        }
      }
    },
    {
      "name": "Submit Career Profile",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"507f1f77bcf86cd799439011\",\n  \"answers\": {\n    \"academic_level\": \"intermediate\",\n    \"field_of_study\": \"computer_science\",\n    \"academic_performance\": \"excellent\",\n    \"favorite_subjects\": [\"mathematics\", \"computer_science\", \"physics\"],\n    \"challenging_subjects\": [],\n    \"primary_interests\": [\"technology\", \"business\"],\n    \"hobbies\": [\"coding\", \"gaming\"],\n    \"programming_skill\": 4,\n    \"mathematics_skill\": 5,\n    \"analytical_thinking\": 4,\n    \"problem_solving\": 5,\n    \"communication_skill\": 3,\n    \"leadership_skill\": 3,\n    \"teamwork_skill\": 4,\n    \"creativity_skill\": 4,\n    \"learning_preference\": \"hands_on\",\n    \"work_environment\": \"flexible\",\n    \"career_priority\": \"growth_opportunities\",\n    \"preferred_location\": \"no_preference\",\n    \"risk_tolerance\": \"medium\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/career/profile",
          "host": ["{{base_url}}"],
          "path": ["career", "profile"]
        }
      }
    },
    {
      "name": "Generate AI Recommendations",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"507f1f77bcf86cd799439011\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/career/recommend",
          "host": ["{{base_url}}"],
          "path": ["career", "recommend"]
        }
      }
    },
    {
      "name": "Send Chat Message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"What programming languages should I focus on for AI development?\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/career/chat/:sessionId",
          "host": ["{{base_url}}"],
          "path": ["career", "chat", ":sessionId"],
          "variable": [
            {
              "key": "sessionId",
              "value": "YOUR_SESSION_ID"
            }
          ]
        }
      }
    },
    {
      "name": "Get Session Details",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/career/session/:sessionId",
          "host": ["{{base_url}}"],
          "path": ["career", "session", ":sessionId"],
          "variable": [
            {
              "key": "sessionId",
              "value": "YOUR_SESSION_ID"
            }
          ]
        }
      }
    },
    {
      "name": "Get User Profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/career/profile/:userId",
          "host": ["{{base_url}}"],
          "path": ["career", "profile", ":userId"],
          "variable": [
            {
              "key": "userId",
              "value": "507f1f77bcf86cd799439011"
            }
          ]
        }
      }
    },
    {
      "name": "Get Active Session",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/career/session/active/:userId",
          "host": ["{{base_url}}"],
          "path": ["career", "session", "active", ":userId"],
          "variable": [
            {
              "key": "userId",
              "value": "507f1f77bcf86cd799439011"
            }
          ]
        }
      }
    },
    {
      "name": "Get Session Analytics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/career/analytics/:sessionId",
          "host": ["{{base_url}}"],
          "path": ["career", "analytics", ":sessionId"],
          "variable": [
            {
              "key": "sessionId",
              "value": "YOUR_SESSION_ID"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    }
  ]
}
