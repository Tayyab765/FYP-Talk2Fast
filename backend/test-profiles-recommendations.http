###############################################################################
# Career Counseling API - Profile Testing for Different Career Paths
# Test profiles designed to recommend specific fields
###############################################################################

@baseUrl = http://localhost:5000

###############################################################################
# PROFILE 1: SOFTWARE ENGINEERING PATH
# Strong technical skills, loves coding, problem-solving oriented
###############################################################################

### 1A. Submit Software Engineering Profile
POST {{baseUrl}}/api/career/profile
Content-Type: application/json

{
  "userId": "student_software_001",
  "answers": {
    
    // ===== ACADEMIC BACKGROUND =====
    "academic_level": "intermediate",
    "field_of_study": "computer_science",
    "academic_performance": "excellent",
    "favorite_subjects": ["computer_science", "mathematics", "physics"],
    "challenging_subjects": [],
    
    // ===== INTEREST ASSESSMENT =====
    // Strong interest in technology and problem-solving
    "enjoy_solving_logical_problems": 5,
    "like_working_with_computers": 5,
    "enjoy_creative_tasks": 4,
    "like_analyzing_data": 5,
    "enjoy_understanding_systems": 5,
    "prefer_planning_over_execution": 3,
    "enjoy_helping_people": 3,
    "curious_about_business": 2,
    "enjoy_research": 4,
    "like_learning_new_tools": 5,
    "hobbies": ["coding", "gaming", "diy"],
    
    // ===== SKILLS & STRENGTHS =====
    // Excellent technical skills
    "mathematical_skills": 5,
    "learn_programming_quickly": 5,
    "communicate_ideas_clearly": 4,
    "problem_solving_under_pressure": 5,
    "comfortable_with_data": 5,
    "lead_team_effectively": 3,
    "logical_reasoning": 5,
    "adapt_to_challenges": 5,
    "attention_to_detail": 5,
    "creative_problem_solving": 5,
    "learning_preference": "hands_on",
    
    // ===== PERSONALITY TRAITS =====
    // Independent, practical, enjoys challenges
    "prefer_working_independently": 4,
    "enjoy_taking_responsibility": 4,
    "remain_calm_under_pressure": 5,
    "like_structured_environments": 3,
    "comfortable_taking_risks": 4,
    "prefer_routine": 2,
    "enjoy_interacting_with_people": 3,
    "motivated_by_long_term_goals": 5,
    "like_abstract_problems": 5,
    "enjoy_practical_work": 5,
    
    // ===== WORK STYLE & PREFERENCES =====
    // Tech environment, continuous learning
    "preferred_work_environment": "remote",
    "problem_solving_approach": "logic_data",
    "career_motivation": "learning_growth",
    "exciting_work_type": "designing_systems",
    "continuous_learning_attitude": "enjoy_pursue",
    "preferred_location": "international",
    
    // ===== CAREER INCLINATION =====
    "appealing_role": "software_engineer"
  }
}



### 1B. Generate Recommendations for Software Engineering Profile
POST {{baseUrl}}/api/career/recommend
Content-Type: application/json

{
  "userId": "student_software_001"
}


