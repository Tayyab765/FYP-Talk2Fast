### STEP 3: Generate Recommendations
# @name generateRecommendations
POST {{baseUrl}}/api/career/recommend
Authorization: Bearer {{token}}

### STEP 4: Get Active Session
GET {{baseUrl}}/api/career/session/active
Authorization: Bearer {{token}}

### STEP 5: Send First Chat Message
POST {{baseUrl}}/api/career/chat/{{sessionId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "message": "What universities in Pakistan offer the best programs for this degree?"
}

### STEP 6: Send Follow-up Chat Message
POST {{baseUrl}}/api/career/chat/{{sessionId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "message": "How long will it take to complete this degree?"
}

### STEP 7: Get Session Analytics
GET {{baseUrl}}/api/career/analytics/{{sessionId}}
Authorization: Bearer {{token}}

### STEP 8: Get Full Session Details
GET {{baseUrl}}/api/career/session/{{sessionId}}
Authorization: Bearer {{token}}

###############################################
# NOTES
###############################################

# 1. Replace {{token}} with actual JWT token from auth service
# 2. Replace {{guestId}} with actual guest session ID
# 3. Replace {{sessionId}} with actual session ID from recommendation response
# 4. For testing via gateway, use baseUrl (port 5000)
# 5. For direct service testing, use directUrl (port 5003)
# 6. Guest sessions require x-guest-id header instead of Authorization
# 7. All authenticated endpoints return 401 without proper auth
# 8. Session endpoints verify ownership - users can only access their own sessions


