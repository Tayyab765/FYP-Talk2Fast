############################
### GUEST USER CHATBOT   ###
############################

### Guest: send message (first request, will create new guest session)
POST http://localhost:5000/api/chatbot/message
Content-Type: application/json
x-guest-id: guest_67d6c77b-7915-416e-9f9c-3f91af9ce7b2

{
  "recipient_id": "ai-bot",
  "message": "Hello, I'm a guest user. Can you help me?"
}

### Guest: send another message (returning guest)
POST http://localhost:5000/api/chatbot/message
Content-Type: application/json
x-guest-id: guest_ce16dcca-54e7-4412-bc25-780cf3cf5977

{
  "recipient_id": "ai-bot",
  "message": "What services do you offer?"
}

### Guest: get conversation history by guest ID
GET http://localhost:5000/api/chatbot/history/guest_abc123xyz
x-guest-id: guest_67d6c77b-7915-416e-9f9c-3f91af9ce7b2

### Guest: get conversation history by conversation ID
GET http://localhost:5000/api/chatbot/history/691f18a5fa3a4e3e8965507e
x-guest-id: guest_67d6c77b-7915-416e-9f9c-3f91af9ce7b2


### Guest: clear conversation history
DELETE http://localhost:5000/api/chatbot/history/691f18a5fa3a4e3e8965507e
x-guest-id: guest_67d6c77b-7915-416e-9f9c-3f91af9ce7b2


####################
### Google OAuth ###
####################

### Step 1: Initiate Google OAuth login
# This will return a Google OAuth URL - copy it and open in browser
GET http://localhost:5000/api/auth/google?mobile=true
### Step 2: After Google login, you'll be redirected to /api/auth/google/callback
# Then redirected to frontend with tokens in URL
# Example callback (this is automatic, for testing only):
GET http://localhost:5000/api/auth/google/callback?code=AUTHORIZATION_CODE