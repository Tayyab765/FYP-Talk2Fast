{
  "name": "talk2fast-backend",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  
  "license": "MIT",
  "workspaces": [
    "./gateway-service",
    "./services/*"
  ],
  "scripts": {
    "start:monolith": "node server.js",
    "dev:monolith": "nodemon server.js",
    "start": "npm-run-all -p start:gateway start:auth start:chatbot",
    "dev": "npm-run-all -p dev:gateway dev:auth dev:chatbot",
    "start:gateway": "cd gateway-service && npm start",
    "start:auth": "cd services/auth-service && npm start",
    "start:chatbot": "cd services/chatbot-service && npm start",
    "dev:gateway": "cd gateway-service && npm run dev",
    "dev:auth": "cd services/auth-service && npm run dev",
    "dev:chatbot": "cd services/chatbot-service && npm run dev",
    "install:all": "npm install && cd gateway-service && npm install && cd ../services/auth-service && npm install && cd ../chatbot-service && npm install",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.8.0",
    "bson": "^6.10.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-validator": "^7.2.1",
    "form-data": "^4.0.4",
    "joi": "^18.0.2",
    "mongodb": "^6.21.0",
    "mongoose": "^8.20.0",
    "multer": "^2.0.2",
    "openai": "^6.7.0",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.34.5",
    "tesseract.js": "^6.0.1",
    "ts-lib": "^0.0.5",
    "tslib": "^2.8.1",
    "uuid": "^13.0.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "nodemon": "^2.0.22",
    "npm-run-all": "^4.1.5",
    "supertest": "^7.1.4"
  }
}
